#include <windows.h>
#pragma code_page(65001)
101 ICON "assets/app.ico"
1 VERSIONINFO
FILEVERSION 0,6,0,0
PRODUCTVERSION 0,6,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "DLSS All Tools"
   VALUE "FileVersion", "0.6.0"
   VALUE "ProductName", "DLSS All Tools"
   VALUE "ProductVersion", "0.6.0"
   VALUE "OriginalFilename", "DLSSAllTools.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
